{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the app's own commands, no other Tauri APIs.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info", "allow-start", "allow-stop", "allow-status", "allow-log-since",
    "allow-get-settings", "allow-set-settings", "allow-open-link", "allow-open-log-folder", "allow-install-pack"
  ]
}
